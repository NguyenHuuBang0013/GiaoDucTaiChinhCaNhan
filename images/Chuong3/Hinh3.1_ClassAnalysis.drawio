        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nhide methods\nclass User {\n +userId: Long\n +oidcSubject: String\n +email: String\n +displayName: String\n}\nclass Category {\n +categoryId: Long\n +userId: Long\n +name: String\n +type: CategoryType\n}\nclass Transaction {\n +transactionId: Long\n +userId: Long\n +categoryId: Long [0..1]\n +type: TransactionType\n +amount: Decimal\n +date: Date\n +note: String [0..1]\n}\nclass Budget {\n +budgetId: Long\n +userId: Long\n +name: String\n +startDate: Date\n +endDate: Date\n +totalLimit: Decimal\n +status: BudgetStatus\n}\nclass BudgetItem {\n +budgetItemId: Long\n +budgetId: Long\n +categoryId: Long\n +limitAmount: Decimal\n}\nclass FinancialGoal {\n +goalId: Long\n +userId: Long\n +name: String\n +targetAmount: Decimal\n +deadline: Date\n +status: GoalStatus\n}\nclass GoalContribution {\n +contributionId: Long\n +goalId: Long\n +amount: Decimal\n +contributionDate: Date\n +note: String [0..1]\n}\nclass SavingScenario {\n +scenarioId: Long\n +userId: Long\n +name: String\n +incomePerPeriod: Decimal\n +expensePerPeriod: Decimal\n +period: PeriodUnit\n +duration: Integer\n +initialSaving: Decimal\n}\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Category : sở hữu &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Transaction : ghi nhận &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Budget : lập &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; FinancialGoal : đặt ra &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; SavingScenario : tạo &gt;\nCategory \&quot;0..1\&quot; &lt;-- \&quot;0..*\&quot; Transaction : phân loại\nBudget \&quot;1\&quot; *-- \&quot;0..*\&quot; BudgetItem : phân bổ\nCategory \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; BudgetItem : áp dụng\nFinancialGoal \&quot;1\&quot; *-- \&quot;0..*\&quot; GoalContribution : đóng góp\nnote bottom of Transaction\nCHI: bắt buộc có Category thuộc User và loại CHI.\nTHU: Category có thể để trống.\nend note\nnote bottom of BudgetItem\nCategory phải thuộc User sở hữu Budget\nvà thuộc nhóm chi tiêu.\nend note\nnote bottom of FinancialGoal\ncurrentAmount và progress tính từ GoalContribution;\nkhông nhất thiết lưu thành cột riêng.\nend note\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FYmbySCWVUs2XTHpc0M9-1">
